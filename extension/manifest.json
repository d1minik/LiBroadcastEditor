{
  "manifest_version": 3,
  "name": "LiBroadcastEditor",
  "version": "2.2",
  "description": "Customize Lichess broadcast pages visually with LiBroadcastEditor.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://lichess.org/broadcast/*"
  ],
  "background": {
    "service_worker": "element-picker-worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://lichess.org/broadcast/*"
      ],
      "js": [
        "shared.js",
        "content.js",
        "element-picker.js"
      ],
      "css": [
        "content.css",
        "element-picker.css"
      ]
    }
  ]
}
